# Copy to .env and fill locally. Never commit the real key.
CANGYUAN_BASE_URL=https://ai.cangyuansuanli.cn
CANGYUAN_API_KEY=
# 视频模型：必须填写 /v1/models 返回的可用视频模型 ID。
CANGYUAN_VIDEO_MODEL=sd10-seedance-2.0
# 如视频账号与文本账号不同，填写独立的视频网关和 Key；留空则回退到 CANGYUAN_*。
CANGYUAN_VIDEO_BASE_URL=https://ai.cangyuansuanli.cn
CANGYUAN_VIDEO_API_KEY=
# 编剧助手的文本模型列表，用逗号分隔；第一项是默认模型。
CANGYUAN_TEXT_MODELS=gpt-5.5,gpt-5.6-sol,gpt-5.6-terra,gpt-6-astra,gpt-6-sol
CANGYUAN_TEXT_MODEL=gpt-5.5

# 编剧助手默认复用上面的沧元地址和 Key；需要直连 DeepSeek 时再填写 AI_* 覆盖项。
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
